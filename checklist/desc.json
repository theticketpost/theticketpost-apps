{
    "name": "checklist",
    "description": "To-do lists for your ticket. Create lists and add, edit and tick off their tasks from the app's own page; each section prints the list picked in its inspector. Done tasks print crossed out on the next ticket and then go away. Nothing prints when no task is pending.",
    "version": "1.3.0",
    "author": "eipporko",
    "render_component": true,
    "refresh_component": true,
    "inspector": true,
    "inspector_template": [
        {
            "type": "text",
            "label": "Title",
            "name": "title",
            "value": "To do"
        },
        {
            "type": "select",
            "label": "List",
            "name": "list",
            "value": "To do",
            "options": [
                {
                    "value": "To do",
                    "description": "To do"
                }
            ]
        },
        {
            "type": "link",
            "label": "Create and manage lists",
            "name": "manage",
            "value": "",
            "url": "/api/apps/checklist/tasks?list={list}"
        }
    ],
    "configuration": false
}
